@page
@model ExtendedCrud.Pages.Users.IndexModel
@{
	ViewData["Title"] = "Список пользователей";
}

<style>
    .gmail-card {
        background: #fff;
        border: 1px solid #dadce0;
        border-radius: 12px;
        box-shadow: 0 1px 2px 0 rgba(60,64,67,0.3), 0 1px 3px 1px rgba(60,64,67,0.15);
        overflow: hidden;
    }

    .gmail-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .gmail-table thead th {
            background-color: #f8f9fa;
            color: #5f6368;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #dadce0;
            padding: 12px 16px;
        }

        .gmail-table tbody tr {
            transition: background-color 0.15s ease;
        }

            .gmail-table tbody tr:hover {
                background-color: #f2f6fc !important;
            }

    .gmail-row-blocked {
        background-color: #fce8e6;
    }

    .gmail-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.85rem;
        color: #fff;
        flex-shrink: 0;
    }

    .badge-active {
        background-color: #e6f4ea;
        color: #137333;
        border-radius: 12px;
        padding: 5px 10px;
        font-weight: 500;
    }

    .badge-blocked {
        background-color: #fce8e6;
        color: #c5221f;
        border-radius: 12px;
        padding: 5px 10px;
        font-weight: 500;
    }
</style>

<div class="container-fluid mt-4">
    <div class="gmail-card">
        <div class="d-flex align-items-center justify-content-between p-3 border-bottom bg-light">
            <h5 class="m-0 font-weight-bold text-dark">
                Список пользователей
            </h5>
            <span class="badge bg-secondary">Всего: @Model.Users.Count</span>
        </div>

        <div class="table-responsive">
            <table class="table gmail-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" class="form-check-input" />
                        </th>
                        <th>Пользователь</th>
                        <th>Email</th>
                        <th>Статус</th>
                        <th>Последний вход</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        var isBlocked = user.IsBlocked;
                        <tr class="@(isBlocked ? "gmail-row-blocked" : "")">
                            <td>
                                <input type="checkbox" class="form-check-input" />
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="gmail-avatar" style="background-color: @(isBlocked ? "#d93025" : "#1a73e8");">
                                        @(string.IsNullOrEmpty(user.UserName) ? "U" : user.UserName[0].ToString().ToUpper())
                                    </div>
                                    <span class="fw-semibold">@user.UserName</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @if (isBlocked)
                                {
                                    <span class="badge-blocked">Заблокирован</span>
                                }
                                else
                                {
                                    <span class="badge-active">Активен</span>
                                }
                            </td>
                            <td>
                                @if (user.LastLoginDate.HasValue)
                                {
                                    @user.LastLoginDate.Value.ToString("dd.MM.yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Никогда</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (isBlocked)
                                {
                                    <form method="post" asp-page-handler="Unblock" asp-route-id="@user.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Разблокировать
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Block" asp-route-id="@user.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Заблокировать
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline ms-1">
                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Удалить пользователя?')">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>